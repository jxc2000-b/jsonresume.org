{
  "name": "jsonresume.org",
  "version": "1.0.1",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "lint": "eslint app lib/ats --max-warnings=0 --cache --cache-location node_modules/.cache/.eslintcache",
    "typecheck": "tsc --noEmit -p app/tsconfig.json",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "format": "prettier -w .",
    "prettier": "prettier -c .",
    "dev": "vite --config app/vite.config.ts",
    "build": "vite build --config app/vite.config.ts"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.55.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.4.49",
    "prettier": "^2.8.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "esbuild@<0.25.0": "^0.25.0",
      "vite@<=5.4.20": "^5.4.21",
      "dompurify@<3.2.4": "^3.2.4",
      "glob@>=10.0.0 <10.5.0": "^10.5.0"
    }
  }
}

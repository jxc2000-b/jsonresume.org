{
  "name": "jsonresume.org",
  "version": "1.0.1",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "lint": "eslint lib scripts --max-warnings=0 --cache --cache-location node_modules/.cache/.eslintcache",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsbuildinfo",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "build:pdf": "vitest run scripts/build.test.js",
    "build:chromium": "vitest run scripts/build.test.js -t chromium",
    "build:rendercv": "vitest run scripts/build.test.js -t rendercv",
    "setup:browsers": "playwright install chromium",
    "format": "prettier -w .",
    "prettier": "prettier -c .",
    "dev": "concurrently -n web,api -c cyan,magenta \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "vite --config app/vite.config.ts",
    "dev:api": "node --watch app/server/index.js",
    "build": "vite build --config app/vite.config.ts",
    "start": "node app/server/index.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@jsonresume/theme-stackoverflow": "^2",
    "ai": "^6.0.116",
    "handlebars": "^4.7.8",
    "json-to-pretty-yaml": "^1.2.2",
    "jsonresume-theme-elegant": "^1.16.1",
    "jsonresume-theme-even": "^0.18.1",
    "jsonresume-theme-jacrys": "^1.0.4",
    "jsonresume-theme-kendall": "^0.2.0",
    "jsonresume-theme-macchiato": "^1.1.0",
    "jsonschema": "^1.4.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.0",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.1",
    "playwright": "^1.55.1",
    "qr-image": "^3.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@repo/eslint-config-custom": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^8.55.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.4.49",
    "prettier": "^2.8.0",
    "tailwindcss": "^3.4.17",
    "tsconfig": "workspace:*",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "handlebars@<4.7.8": "^4.7.8",
      "uglify-js@<3.0.0": "^3.19.3",
      "tar@<6.2.1": "^6.2.1",
      "marked@<4.0.10": "^4.0.10",
      "prismjs@<1.30.0": "^1.30.0",
      "cookie@<0.7.0": "^0.7.0",
      "tmp@<0.2.4": "^0.2.4",
      "nth-check@<2.0.1": "^2.1.1",
      "braces@<3.0.3": "^3.0.3",
      "highlight.js@<10.4.1": "^10.7.3",
      "got@<11.8.5": "^11.8.6",
      "markdown-it@<12.3.2": "^12.3.2",
      "postcss@<8.4.31": "^8.4.31",
      "validator@<13.15.20": "^13.15.20",
      "micromatch@<4.0.8": "^4.0.8",
      "pug@<3.0.3": "^3.0.3",
      "pug-code-gen@<3.0.3": "^3.0.3",
      "esbuild@<0.25.0": "^0.25.0",
      "vite@<=5.4.20": "^5.4.21",
      "dompurify@<3.2.4": "^3.2.4",
      "playwright@<1.55.1": "^1.55.1",
      "html-minifier@<=4.0.0": "npm:html-minifier-terser@^7.2.0",
      "lodash.template@<=4.5.0": "npm:lodash@^4.17.21",
      "glob@>=10.0.0 <10.5.0": "^10.5.0"
    }
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@/*": ["./app/src/*"]
    },
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["app/**/*.ts", "app/**/*.tsx"],
  "exclude": [
    "node_modules",
    "packages",
    "public",
    "coverage",
    "app/dist",
    "vitest.config.ts",
    "vitest.setup.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.js",
    "**/*.test.jsx"
  ]
}
